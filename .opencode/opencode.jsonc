{
  // OpenCode v2 project config.
  "$schema": "https://opencode.ai/config.json",

  // Keep the model pointed at repo-local context if needed (optional).
  // "instructions": ["AGENTS.md", "README.md"],

  // MCP: expose the TypeScript language server via mcp-language-server.
  "mcp": {
    "servers": {
      "typescript": {
        "type": "local",
        "command": [
          ".devenv/profile/bin/mcp-language-server",
          "--workspace",
          ".",
          "--lsp",
          ".devenv/profile/bin/typescript-language-server",
          "--",
          "--stdio"
        ]
      }
    }
  },

  // Permissions: allow normal dev operations; block edits into generated/managed paths.
  "permissions": [
    // Allow normal shell commands (tests, git, npm, node, devenv, etc.).
    { "action": "shell", "resource": "biome check *", "effect": "allow" },
    { "action": "shell", "resource": "node --test *", "effect": "allow" },
    { "action": "shell", "resource": "tsc --noEmit", "effect": "allow" },

    // Installed dependencies: not source, overwritten by npm ci/install.
    {
      "action": "edit",
      "resource": "node_modules/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "node_modules/**",
      "effect": "deny"
    },

    // devenv state/cache: managed by devenv, not project source.
    {
      "action": "edit",
      "resource": ".devenv/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".devenv/**",
      "effect": "deny"
    },

    // Generated symlink into the Nix store (see AGENTS.md); change devenv.nix instead.
    {
      "action": "edit",
      "resource": ".pre-commit-config.yaml",
      "effect": "deny"
    }
  ]
}
