{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "opencode-session-temp",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "node --test 'test/**/*.test.ts'",
		"test:live": "node --test 'test/live/*.live.ts'",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 'test/**/*.test.ts'",
		"test:typecheck": "tsc --noEmit",
		"check": "biome check ."
	},
	"dependencies": {
		"@opencode/plugin": "2.2.6"
	},
	"devDependencies": {
		"@opencode/client": "2.2.6",
		"@types/node": "24.19.2",
		"fast-check": "^4.10.3"
	}
}
